---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const blogName = 'brokentablets';
const siteTitle = title === blogName ? title : `${title} | ${blogName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="brokentablets RSS" href="/rss.xml" />
		<title>{siteTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">brokentablets</a>
			<nav aria-label="Primary navigation">
				<a href="/">Posts</a>
				<a href="https://x.com/jehuamanna" rel="me noreferrer">X</a>
				<a href="https://www.linkedin.com/in/jehuamanna/" rel="me noreferrer">LinkedIn</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>brokentablets by Jehu Amanna. Tinkerer writing about computer programming.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #f8f7f2;
		--ink: #1f2522;
		--muted: #5f6862;
		--line: #d9d6c9;
		--accent: #b3352b;
		--accent-ink: #7b211b;
		--panel: #ffffff;
		--shadow: 0 18px 50px rgba(31, 37, 34, 0.08);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
	}

	body {
		margin: 0;
		color: var(--ink);
		background:
			linear-gradient(90deg, rgba(179, 53, 43, 0.07) 1px, transparent 1px) 0 0 / 44px 44px,
			var(--bg);
		font-size: 16px;
		line-height: 1.65;
	}

	a {
		color: inherit;
		text-decoration-color: rgba(179, 53, 43, 0.35);
		text-decoration-thickness: 0.09em;
		text-underline-offset: 0.18em;
	}

	a:hover,
	a:focus-visible {
		color: var(--accent-ink);
		text-decoration-color: currentColor;
	}

	.site-header,
	main,
	.site-footer {
		width: min(100% - 32px, 920px);
		margin-inline: auto;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.35rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 18px;
		color: var(--muted);
		font-size: 0.95rem;
	}

	nav a {
		text-decoration: none;
	}

	main {
		padding: 56px 0 72px;
	}

	.intro {
		max-width: 720px;
		padding-bottom: 52px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		font-family: Georgia, "Times New Roman", serif;
		line-height: 1.08;
		letter-spacing: 0;
	}

	h1 {
		max-width: 760px;
		margin: 0;
		font-size: 5.4rem;
	}

	.intro p:last-child {
		max-width: 620px;
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 1.2rem;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 7px 13px;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 8px;
		color: var(--ink);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
	}

	.featured {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 24px;
		align-items: start;
		padding: 28px;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 8px;
		box-shadow: var(--shadow);
	}

	.featured h2 {
		margin: 0;
		font-size: 3rem;
	}

	.featured h2 a {
		text-decoration: none;
	}

	.featured p:last-child {
		max-width: 620px;
		margin: 18px 0 0;
		color: var(--muted);
	}

	time {
		color: var(--muted);
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.post-list {
		margin-top: 56px;
	}

	.post-list h2 {
		margin: 0 0 18px;
		font-size: 1.6rem;
	}

	.post-list ul {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.post-list li {
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
	}

	.post-list li > a {
		display: flex;
		justify-content: space-between;
		gap: 18px;
		text-decoration: none;
	}

	.post-list span {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.18;
	}

	.post-list p {
		max-width: 640px;
		margin: 10px 0 0;
		color: var(--muted);
	}

	.article {
		max-width: 740px;
		margin-inline: auto;
	}

	.article-header {
		padding-bottom: 28px;
		border-bottom: 1px solid var(--line);
	}

	.article-header h1 {
		font-size: 4.2rem;
	}

	.article-description {
		margin: 22px 0 0;
		color: var(--muted);
		font-size: 1.18rem;
	}

	.article-content {
		padding-top: 22px;
	}

	.article-content h2 {
		margin-top: 42px;
		font-size: 2rem;
	}

	.article-content p,
	.article-content li {
		color: #303833;
	}

	.article-content code {
		padding: 0.13em 0.32em;
		background: rgba(179, 53, 43, 0.1);
		border-radius: 4px;
		font-size: 0.92em;
	}

	.article-content pre {
		overflow-x: auto;
		padding: 18px;
		background: #202723;
		color: #f5f2e9;
		border-radius: 8px;
	}

	.site-footer {
		padding: 28px 0 40px;
		color: var(--muted);
		border-top: 1px solid var(--line);
	}

	@media (max-width: 640px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		main {
			padding-top: 38px;
		}

		.featured,
		.post-list li > a {
			grid-template-columns: 1fr;
			display: grid;
		}

		time {
			white-space: normal;
		}

		h1 {
			font-size: 3rem;
		}

		.featured h2 {
			font-size: 2rem;
		}

		.article-header h1 {
			font-size: 2.8rem;
		}
	}
</style>

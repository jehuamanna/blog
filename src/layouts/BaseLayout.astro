---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const blogName = 'brokentablets';
const siteTitle = title === blogName ? title : `${title} | ${blogName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="brokentablets RSS" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;600;700&family=Karla:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{siteTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">brokentablets</a>
			<nav aria-label="Primary navigation">
				<a href="/">Posts</a>
				<a href="https://x.com/jehuamanna" rel="me noreferrer">X</a>
				<a href="https://www.linkedin.com/in/jehuamanna/" rel="me noreferrer">LinkedIn</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</header>
		<svg class="crack crack--divider" viewBox="0 0 1200 20" preserveAspectRatio="none" aria-hidden="true">
			<path
				d="M0 10 L120 8 L190 13 L310 5 L420 12 L540 7 L660 14 L790 6 L910 12 L1040 8 L1200 11"
			></path>
		</svg>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>brokentablets by Jehu Amanna. Tinkerer writing about computer programming.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		/* limestone — default */
		--bg: #e6e0d1;
		--panel: #f2eee2;
		--panel-recess: #d6cfba;
		--ink: #262320;
		--muted: #6b6255;
		--line: rgba(38, 35, 32, 0.18);
		--verdigris: #3f7360;
		--clay: #9c5a28;
		--crack: rgba(38, 35, 32, 0.28);

		font-family: Karla, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* basalt */
			--bg: #211f1d;
			--panel: #2a2723;
			--panel-recess: #191715;
			--ink: #ece4d3;
			--muted: #a89e8c;
			--line: rgba(236, 228, 211, 0.14);
			--verdigris: #83b39d;
			--clay: #d69455;
			--crack: rgba(236, 228, 211, 0.2);
		}
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
	}

	body {
		margin: 0;
		color: var(--ink);
		background:
			radial-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1.4px) 0 0 / 22px 22px,
			var(--bg);
		font-size: 16px;
		line-height: 1.7;
	}

	@media (prefers-color-scheme: dark) {
		body {
			background:
				radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1.4px) 0 0 / 22px 22px,
				var(--bg);
		}
	}

	a {
		color: inherit;
		text-decoration-color: color-mix(in srgb, var(--clay) 55%, transparent);
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	a:hover,
	a:focus-visible {
		color: var(--verdigris);
		text-decoration-color: currentColor;
	}

	:focus-visible {
		outline: 2px solid var(--verdigris);
		outline-offset: 3px;
	}

	.site-header,
	main,
	.site-footer {
		width: min(100% - 32px, 920px);
		margin-inline: auto;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 26px 0 22px;
	}

	.brand {
		font-family: "Zilla Slab", Georgia, serif;
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 18px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
	}

	nav a {
		text-decoration: none;
	}

	.crack {
		display: block;
		width: 100%;
		height: 14px;
	}

	.crack path {
		fill: none;
		stroke: var(--crack);
		stroke-width: 1.5;
		vector-effect: non-scaling-stroke;
	}

	.crack--divider {
		margin-bottom: 8px;
	}

	.crack--hero {
		height: 26px;
		margin: 4px 0 0;
	}

	.crack--hero path {
		stroke: var(--clay);
		stroke-width: 2;
		opacity: 0.65;
	}

	main {
		padding: 46px 0 76px;
	}

	.intro {
		max-width: 760px;
		padding-bottom: 56px;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--verdigris);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		font-family: "Zilla Slab", Georgia, serif;
		line-height: 1.06;
		letter-spacing: -0.01em;
	}

	h1 {
		max-width: 780px;
		margin: 0;
		font-size: clamp(3rem, 9vw, 5.6rem);
		font-weight: 700;
	}

	.intro p:last-child {
		max-width: 620px;
		margin: 28px 0 0;
		color: var(--muted);
		font-size: 1.15rem;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 26px;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		min-height: 38px;
		padding: 7px 14px;
		background: var(--panel);
		border: 1px solid var(--line);
		color: var(--ink);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
	}

	.featured {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 24px;
		align-items: start;
		padding: 30px;
		background: var(--panel);
		border: 1px solid var(--line);
		box-shadow:
			inset 0 2px 6px var(--panel-recess),
			inset 0 -1px 0 rgba(255, 255, 255, 0.04);
	}

	.featured h2 {
		margin: 10px 0 0;
		font-size: clamp(1.8rem, 4vw, 2.7rem);
	}

	.featured h2 a {
		text-decoration: none;
	}

	.featured p:last-child {
		max-width: 620px;
		margin: 16px 0 0;
		color: var(--muted);
	}

	.accession {
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
		white-space: nowrap;
	}

	.post-list {
		margin-top: 60px;
	}

	.post-list h2 {
		margin: 0 0 20px;
		font-size: 1.4rem;
	}

	.post-list > ul {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.post-list > ul > li {
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
	}

	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 18px;
	}

	.entry-head > a {
		text-decoration: none;
	}

	.post-list span {
		font-family: "Zilla Slab", Georgia, serif;
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.18;
	}

	.post-list p {
		max-width: 640px;
		margin: 10px 0 0;
		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 14px;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 3px 9px;
		border: 1px solid var(--line);
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.74rem;
	}

	.article {
		max-width: 740px;
		margin-inline: auto;
	}

	.article-header {
		padding-bottom: 30px;
		border-bottom: 1px solid var(--line);
	}

	.article-header h1 {
		margin-top: 10px;
		font-size: clamp(2.4rem, 6vw, 4rem);
	}

	.article-description {
		margin: 22px 0 0;
		color: var(--muted);
		font-size: 1.14rem;
	}

	.article-header time {
		display: inline-block;
		margin-top: 18px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.85rem;
	}

	.article-content {
		padding-top: 26px;
	}

	.article-content h2 {
		margin-top: 44px;
		font-size: 1.9rem;
	}

	.article-content p,
	.article-content li {
		color: var(--ink);
	}

	.article-content code {
		padding: 0.13em 0.34em;
		background: color-mix(in srgb, var(--clay) 16%, transparent);
		font-size: 0.92em;
	}

	.article-content pre {
		overflow-x: auto;
		padding: 20px;
		background: var(--panel-recess);
		color: var(--ink);
		border: 1px solid var(--line);
	}

	.article-content pre code {
		padding: 0;
		background: none;
	}

	.site-footer {
		padding: 30px 0 44px;
		color: var(--muted);
		border-top: 1px solid var(--line);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
	}

	@media (max-width: 640px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		main {
			padding-top: 34px;
		}

		.featured,
		.entry-head {
			grid-template-columns: 1fr;
			display: grid;
		}

		.accession {
			white-space: normal;
		}
	}
</style>

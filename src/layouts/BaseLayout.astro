---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const blogName = 'brokentablets';
const siteTitle = title === blogName ? title : `${title} | ${blogName}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title="brokentablets RSS" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;600;700&family=Karla:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{siteTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">brokentablets</a>
			<nav aria-label="Primary navigation">
				<a href="/">Posts</a>
				<a href="https://x.com/jehuamanna" rel="me noreferrer">X</a>
				<a href="https://www.linkedin.com/in/jehuamanna/" rel="me noreferrer">LinkedIn</a>
				<a href="/rss.xml">RSS</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>brokentablets by Jehu Amanna. Tinkerer writing about computer programming.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		--bg: #ffffff;
		--ink: #0a0a0a;
		--muted: #666666;
		--line: rgba(10, 10, 10, 0.16);
		--invert-bg: #0a0a0a;
		--invert-ink: #ffffff;

		font-family: Karla, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0a0a0a;
			--ink: #f5f5f5;
			--muted: #999999;
			--line: rgba(245, 245, 245, 0.18);
			--invert-bg: #f5f5f5;
			--invert-ink: #0a0a0a;
		}
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
		color: var(--ink);
		background: var(--bg);
		font-size: 16px;
		line-height: 1.7;
	}

	main {
		flex: 1 0 auto;
	}

	a {
		color: inherit;
		text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.18em;
	}

	a:hover,
	a:focus-visible {
		color: var(--ink);
		text-decoration-color: currentColor;
	}

	:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.site-header,
	main,
	.site-footer {
		width: min(100% - 32px, 920px);
		margin-inline: auto;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 26px 0 22px;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		font-family: "Zilla Slab", Georgia, serif;
		font-size: 1.3rem;
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 18px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
	}

	nav a {
		text-decoration: none;
	}

	.crack {
		display: block;
		width: 100%;
		height: 26px;
		margin: 4px 0 0;
	}

	.crack path {
		fill: none;
		stroke: var(--ink);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}

	main {
		padding: 46px 0 76px;
	}

	.intro {
		max-width: 760px;
		padding-bottom: 56px;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		font-family: "Zilla Slab", Georgia, serif;
		line-height: 1.06;
		letter-spacing: -0.01em;
	}

	h1 {
		max-width: 780px;
		margin: 0;
		font-size: clamp(3rem, 9vw, 5.6rem);
		font-weight: 700;
	}

	.intro p:last-child {
		max-width: 620px;
		margin: 28px 0 0;
		color: var(--muted);
		font-size: 1.15rem;
	}

	.featured {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 24px;
		align-items: start;
		padding: 30px;
		background: var(--invert-bg);
		color: var(--invert-ink);
	}

	.featured .eyebrow {
		color: var(--invert-ink);
		opacity: 0.6;
	}

	.featured h2 {
		margin: 10px 0 0;
		font-size: clamp(1.8rem, 4vw, 2.7rem);
	}

	.featured h2 a {
		text-decoration: none;
	}

	.featured a:hover,
	.featured a:focus-visible {
		color: var(--invert-ink);
		opacity: 0.75;
	}

	.featured p:last-child {
		max-width: 620px;
		margin: 16px 0 0;
		color: var(--invert-ink);
		opacity: 0.75;
	}

	.featured .accession {
		color: var(--invert-ink);
		opacity: 0.6;
	}

	.accession {
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
		white-space: nowrap;
	}

	.post-list {
		margin-top: 60px;
	}

	.post-list h2 {
		margin: 0 0 20px;
		font-size: 1.4rem;
	}

	.post-list > ul {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.post-list > ul > li {
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
	}

	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 18px;
	}

	.entry-head > a {
		text-decoration: none;
	}

	.post-list span {
		font-family: "Zilla Slab", Georgia, serif;
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.18;
	}

	.post-list p {
		max-width: 640px;
		margin: 10px 0 0;
		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 14px;
		padding: 0;
		list-style: none;
	}

	.tags li {
		border: 1px solid var(--line);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.74rem;
	}

	.tags li a {
		display: block;
		padding: 3px 9px;
		color: var(--muted);
		text-decoration: none;
	}

	.tags li a:hover,
	.tags li a:focus-visible {
		background: var(--invert-bg);
		color: var(--invert-ink);
	}

	.article {
		max-width: 740px;
		margin-inline: auto;
	}

	.article-header {
		padding-bottom: 30px;
		border-bottom: 1px solid var(--line);
	}

	.back-link {
		display: inline-flex;
		margin-bottom: 22px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
		text-decoration: none;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--ink);
	}

	.article-header h1 {
		margin-top: 10px;
		font-size: clamp(2.4rem, 6vw, 4rem);
	}

	.article-description {
		margin: 22px 0 0;
		color: var(--muted);
		font-size: 1.14rem;
	}

	.article-header time {
		display: inline-block;
		margin-top: 18px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.85rem;
	}

	.article-content {
		padding-top: 26px;
	}

	.article-content h2 {
		margin-top: 44px;
		font-size: 1.9rem;
	}

	.article-content p,
	.article-content li {
		color: var(--ink);
	}

	.article-content hr {
		margin: 44px 0;
		border: none;
		border-top: 1px solid var(--line);
	}

	.article-content hr + p em {
		color: var(--muted);
		font-size: 0.92rem;
	}

	.series-nav {
		margin: 22px 0 0;
		padding: 16px 20px;
		border: 1px solid var(--line);
		font-size: 0.92rem;
	}

	.series-nav p {
		margin: 0 0 8px;
		color: var(--muted);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.series-nav ol {
		margin: 0;
		padding-left: 20px;
	}

	.series-nav li {
		margin: 4px 0;
	}

	.article-content code {
		padding: 0.13em 0.34em;
		background: color-mix(in srgb, var(--ink) 8%, transparent);
		font-size: 0.92em;
	}

	.article-content pre {
		overflow-x: auto;
		padding: 20px;
		background: var(--invert-bg);
		color: var(--invert-ink);
	}

	.article-content pre code {
		padding: 0;
		background: none;
	}

	.article-content table {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 28px 0;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	.article-content th,
	.article-content td {
		padding: 10px 20px 10px 0;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--line);
	}

	.article-content thead th {
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 2px solid var(--ink);
	}

	.article-content tbody tr:last-child td {
		border-bottom: none;
	}

	.site-footer {
		padding: 30px 0 44px;
		color: var(--muted);
		border-top: 1px solid var(--line);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.82rem;
	}

	@media (max-width: 640px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		main {
			padding-top: 34px;
		}

		.featured,
		.entry-head {
			grid-template-columns: 1fr;
			display: grid;
		}

		.accession {
			white-space: normal;
		}
	}
</style>
